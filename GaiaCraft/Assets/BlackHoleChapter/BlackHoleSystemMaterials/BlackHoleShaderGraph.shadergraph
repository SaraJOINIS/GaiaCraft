{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "1963bbbaa58f4d3388e36d7da03cb1a2",
    "m_Title": "Transform",
    "m_Content": "Permet de changer l'angle de vue: on change la base dans laquelle est exprimée la normale (on passe de la base objet vers la base caméra). On s'assure ainsi que l'effet de distorsion de lumière autour du trou noir soit indépendant du point de vue.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
